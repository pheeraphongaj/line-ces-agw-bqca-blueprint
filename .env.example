# ==============================================================================
# Google Cloud Project & Region Configuration
# ==============================================================================
GCP_PROJECT_ID="your-agent-host-project-id"
GCP_PROJECT_NUMBER="123456789012"
GCP_REGION="us-central1"
BQ_DATA_PROJECT_ID="your-bigquery-data-project-id"
BQ_DATASET_ID="iowa_liquor_sales"
BQ_TABLE_ID="sales"

# ==============================================================================
# Next-Gen CX Agent Studio (CES) & BigQuery Conversational Analytics (BQCA)
# ==============================================================================
CES_LOCATION="us"
CES_APP_ID="your-ces-app-uuid"
BQCA_LOCATION="us"
BQCA_AGENT_ID="your-bqca-data-agent-id"

# ==============================================================================
# Cloud Storage & Cloud Run Endpoints
# Resolved dynamically at deploy time via:
#   gcloud run services describe <service> --region=$GCP_REGION --format='value(status.url)'
# ==============================================================================
CHART_BUCKET="your-agent-host-project-id-line-charts"
PUBLIC_BASE_URL="https://line-bqca-adapter-<REGION_HASH>.a.run.app"
IAP_AUTH_BASE_URL="https://line-iap-auth-<REGION_HASH>.a.run.app"

# ==============================================================================
# LINE Official Account (Messaging API) Configuration
# Inject via Google Cloud Secret Manager in production (--set-secrets)
# ==============================================================================
LINE_CHANNEL_ID="your-line-channel-id"
LINE_BOT_HANDLE="@your-line-oa"
LINE_CHANNEL_SECRET="your-32-char-line-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="your-line-long-lived-channel-access-token"
LINE_REPLY_CUTOFF_SECONDS="22.0"

# ==============================================================================
# LINE Rich Menu IDs (Created by scripts/configure_line_richmenus.py)
# ==============================================================================
LOGIN_RICHMENU_ID="richmenu-your-1card-login-menu-id"
UNLOCKED_RICHMENU_ID="richmenu-your-6card-analytics-menu-id"

# ==============================================================================
# Partner RLS & Stateless IAM STS Configuration
# ==============================================================================
PARTNER_PASSWORD_SALT="replace-with-random-production-salt"
DEFAULT_INTERNAL_SA="123456789012-compute@developer.gserviceaccount.com"
PARTNER_POLK_SA="sa-partner-polk@your-agent-host-project-id.iam.gserviceaccount.com"
PARTNER_EAST_SA="sa-partner-east@your-agent-host-project-id.iam.gserviceaccount.com"
